//////////////////////////////////////////////////////////////////////////////
// RT_MENU

IDR_BINEDIT_CTX_MENU MENU
{
    POPUP "Popup #0"
    {
        MENUITEM "切り取り(&T)\tCtrl+X", ID_BINEDIT_CUT
        MENUITEM "コピー(&C)\tCtrl+C", ID_BINEDIT_COPY
        MENUITEM "貼り付け(&P)\tCtrl+V", ID_BINEDIT_PASTE
        MENUITEM "削除(&D)\tDel", ID_BINEDIT_DELETE
        MENUITEM SEPARATOR
        MENUITEM "すべて選択(&A)\tCtrl+A", ID_BINEDIT_SELECTALL
        MENUITEM "オフセットへ移動(&G)...\tCtrl+G", ID_BINEDIT_GOTO
        MENUITEM SEPARATOR
        MENUITEM "ANSI", ID_BINEDIT_ANSI
        MENUITEM "UTF-8", ID_BINEDIT_UTF8
        MENUITEM "UTF-16", ID_BINEDIT_UTF16
        MENUITEM "シフトJIS", ID_BINEDIT_SJIS
        MENUITEM SEPARATOR
        MENUITEM "ダンプ文字列をコピー(&U)", ID_BINEDIT_COPYDUMPTEXT
    }
}

//////////////////////////////////////////////////////////////////////////////

LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT

//////////////////////////////////////////////////////////////////////////////
// RT_MENU

1 MENU
{
    POPUP "ファイル(&F)"
    {
        MENUITEM "開く(&O)...", ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "終了(&X)\tAlt+F4", ID_EXIT
    }
    POPUP "表示(&V)"
    {
        MENUITEM "ANSI", ID_ANSI
        MENUITEM "UTF-8", ID_UTF8
        MENUITEM "UTF-16", ID_UTF16
        MENUITEM SEPARATOR
        MENUITEM "ヘッダーを表示(&H)", ID_TOGGLE_HEADER, CHECKED
    }
}

//////////////////////////////////////////////////////////////////////////////
// RT_DIALOG

IDD_GOTO_OFFSET DIALOGEX 0, 0, 200, 92
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "オフセットへ移動"
FONT 9, "MS Shell Dlg", 0, 0, 0x0
BEGIN
    LTEXT           "オフセット:", stc1, 7, 9, 52, 8
    EDITTEXT        edt1, 62, 7, 131, 12, ES_AUTOHSCROLL | WS_TABSTOP, WS_EX_CLIENTEDGE
    LTEXT           "", stc2, 7, 24, 186, 10
    CONTROL         "16進数(&H)", rad1, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 7, 40, 85, 10
    CONTROL         "10進数(&D)", rad2, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 95, 40, 85, 10
    DEFPUSHBUTTON   "OK", IDOK, 88, 68, 50, 14, WS_TABSTOP
    PUSHBUTTON      "キャンセル", IDCANCEL, 143, 68, 50, 14, WS_TABSTOP
END

